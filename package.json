{
  "name": "e2e-playwright",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test --pass-with-no-tests",
    "test:smoke": "playwright test --pass-with-no-tests --grep @smoke",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "auth": "playwright test --project=setup --pass-with-no-tests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
